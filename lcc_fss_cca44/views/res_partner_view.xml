<?xml version="1.0"?>
<odoo>
    <data>
        <record id="lcc_fss_form_view" model="ir.ui.view">
            <field name="name">LCC FSS Members Form View</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form" />
            <field name="priority">99</field>
            <field name="arch" type="xml">
                <xpath expr="//page[@name='personal_information_page']/group[@name='fss_data_credit']" position='replace'>
                    <group name="fss_data_credit"
                        string="FSS data to compute credit amount "
                        attrs="{'invisible': [('is_company', '=', True)]}" >
                        <field name="allocation_amount" />
                    </group>
                </xpath>
                <xpath expr="//page[@name='personal_information_page']/group[@name='fss_household_composition']" position='replace'>
                    <group name="fss_household_composition"
                        string="Household composition"
                        attrs="{'invisible': [('is_company', '=', True)]}">
                        <field name="household_composition_adults" />
                        <field name="household_composition_teens" />
                        <field name="household_composition_children_under_fourteen" />
                        <field name="name_of_allocation_beneficiary" />
                    </group>
                </xpath>
                <xpath expr="//page[@name='personal_information_page']/group[@name='fss_experimentation_evaluation_data']" position='replace'>
                    <group name="fss_experimentation_evaluation_data"
                        string="FSS experimentation evaluation data"
                        attrs="{'invisible': [('is_company', '=', True)]}" >
                        <field name="gender" />
                        <field name="birth_year" />
                        <field name="arrival_date_territory" />
                        <field name="socio_professional_category" />
                        <field name="monthly_household_food_budget" />
                    </group>
                </xpath>
                <xpath expr="//page[@name='personal_information_page']/group[@name='fss_third_party']" position='replace' />
                <xpath expr="//page[@name='personal_information_page']/group[@name='fss_pos_data']" position='replace' />
                <xpath expr="//page[@name='personal_information_page']" position='inside'>
                    <group name="fss_other_data"
                        string="FSS other data"
                        attrs="{'invisible': [('is_company', '=', True)]}" >
                        <field name="fss_cca44_comments" />
                        <field name="accept_project_charter" />
                        <field name="accept_cgv" />
                        <field name="identity_document" />
                        <field name="bank_details_document" />
                        <field name="sepa_direct_debit_authorization" />
                    </group>
                </xpath>
            </field>
        </record>
    </data>
</odoo>